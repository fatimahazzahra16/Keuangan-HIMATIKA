# Salin menjadi .env.local lalu isi. File .env.local tidak ikut di-commit.
# Ambil dari Supabase: Project Settings > API.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Hanya anon/publishable key. JANGAN pernah menaruh service role key di sini.
VITE_SUPABASE_ANON_KEY=

# Opsional untuk npm run uji:anon: path sebuah foto bukti yang benar-benar ada
# di bucket "bukti" (contoh: 2026/abc.jpg), supaya tes membuktikan file nyata tidak bisa diunduh.
UJI_BUKTI_PATH=
